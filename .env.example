# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Embedding Model
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ChromaDB
CHROMA_COLLECTION_NAME=cuisine_recipes
CHROMA_PERSIST_DIR=./chroma_db

# Experiment Settings
TARGET_CUISINES=italian,mexican,indian,thai,japanese,southern_us
TEST_SAMPLES_PER_CUISINE=15
FEW_SHOT_K=3
RANDOM_SEED=42
